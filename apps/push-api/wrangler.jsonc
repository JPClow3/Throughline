{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throughline",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "20732bfe402a42ae8e4eaf5c48aec281"
    }
  ],
  "vars": {
    "COOKIE_SECURE": "true",
    "RATE_LIMIT_MAX": "120",
    "TRUST_PROXY": "true"
  }
}
