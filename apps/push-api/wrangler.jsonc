{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throughline-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "throughline-db",
      "database_id": "throughline-db-id",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COOKIE_SECURE": "true",
    "RATE_LIMIT_MAX": "120",
    "TRUST_PROXY": "true"
  }
}
